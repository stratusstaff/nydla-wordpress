{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"color": {
			"palette": [
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#0B1220"
				},
				{
					"slug": "navy",
					"name": "Navy",
					"color": "#13233A"
				},
				{
					"slug": "steel",
					"name": "Steel",
					"color": "#3A4F6A"
				},
				{
					"slug": "mist",
					"name": "Mist",
					"color": "#E8EEF5"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#F7F9FC"
				},
				{
					"slug": "amber",
					"name": "Amber",
					"color": "#C9852A"
				},
				{
					"slug": "sky",
					"name": "Sky",
					"color": "#6B8CAE"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				}
			],
			"defaultPalette": false,
			"defaultGradients": false
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif"
				},
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "\"Segoe UI\", \"Helvetica Neue\", Arial, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "sm",
					"name": "Small",
					"size": "0.875rem",
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "lg",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "1.75rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xxl",
					"name": "XXL",
					"size": "2.75rem",
					"fluid": {
						"min": "2rem",
						"max": "3.25rem"
					}
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "4rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "2xs",
					"name": "2XS",
					"size": "0.25rem"
				},
				{
					"slug": "xs",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "sm",
					"name": "SM",
					"size": "1rem"
				},
				{
					"slug": "md",
					"name": "MD",
					"size": "1.5rem"
				},
				{
					"slug": "lg",
					"name": "LG",
					"size": "2.5rem"
				},
				{
					"slug": "xl",
					"name": "XL",
					"size": "4rem"
				},
				{
					"slug": "xxl",
					"name": "XXL",
					"size": "6rem"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--amber)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "2px"
				}
			}
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--md)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--md)"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
